# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Next.js — the app/ build. This repo runs two toolchains: `npm run dev`
# (Next, app/) and `npm run demos` (Vite, src/), so both sets of artifacts
# need ignoring.
.next/
out/
# Regenerated by Next on every dev/build; never edited by hand.
next-env.d.ts

# TypeScript incremental build state
*.tsbuildinfo

# Environment and secrets. COMMON_SAGE_API and anything alongside it point at
# a real backend — these must never be committed. Commit .env.example instead.
.env
.env.*
!.env.example

# Test and tool output
output/
coverage/
playwright-report/
test-results/

# Deploy
.vercel
*.pem
